# UNDEAD MC tier sayti sozlamalari.
#
# mcweb.uz da: bu qiymatlarni platforma panelidagi muhit o'zgaruvchilari (Environment variables)
#   bo'limiga kiriting. .env fayli kerak emas. PORT ni platforma o'zi beradi.
# Kompyuterda / VPS da: bu faylni .env nomi bilan nusxalang:  cp .env.example .env
# .env faylini hech qachon gitga qo'shmang.

# production — haqiqiy sayt (cookie faqat HTTPS orqali yuboriladi).
# development — kompyuterda http://localhost orqali sinash uchun.
NODE_ENV=production

# Sessiya kaliti — kamida 32 ta tasodifiy belgi. Olish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=almashtiring-kamida-32-ta-tasodifiy-belgi

# Birinchi admin. Bazada hali xodim bo'lmasa, server ishga tushganda shu admin avtomatik yaratiladi.
ADMIN_USERNAME=admin
# Hash olish:  npm run hash-password
# .env faylida bitta qo'shtirnoq ichida yozing ($ belgilari buzilmasligi uchun).
# Platforma panelida qo'shtirnoqsiz kiritsangiz ham bo'ladi.
ADMIN_PASSWORD_HASH='$2b$12$almashtiring.bu.qiymatni.hash-password.bilan.olingan.hashga'

# Admin parolini unutsangiz: yangi ADMIN_PASSWORD_HASH yozing, ADMIN_FORCE_RESET=true qiling va
# qayta ishga tushiring. Kirgandan keyin ADMIN_FORCE_RESET ni o'chiring (aks holda har safar qayta yoziladi).
ADMIN_FORCE_RESET=false

# Baza (tiers.db) va zaxira nusxalar (backups/) papkasi. Platformada doimiy diskka (volume) ulang,
# aks holda har deploy da ma'lumotlar o'chib ketishi mumkin. Standart: ./data
DATA_DIR=./data

# Saytning ommaviy manzili (canonical havolalar va proksi ortidagi xavfsizlik tekshiruvi uchun).
SITE_URL=https://tier.undeadmc.uz

# Discord taklif havolasi (tugmalar va "Tier test olish" bo'limi uchun).
DISCORD_URL=https://discord.gg/KNRKCRJenc

# Avtomatik zaxira: har necha soatda (0 — o'chirilgan) va necha kun saqlanadi.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30

# Port: mcweb.uz o'zi beradi. Kompyuterda / VPS da standart 3000.
# PORT=3000
# Tinglanadigan manzil: bo'sh — barcha interfeyslar (platforma uchun). VPS + nginx da: 127.0.0.1
# HOST=127.0.0.1
